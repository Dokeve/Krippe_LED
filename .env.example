# .env.example
# Saubere Beispielkonfiguration für das Projekt
# Kopiere diese Datei nach .env und passe die Werte für deine Umgebung an.

# --------------------- Laufzeit ---------------------
NODE_ENV=production
PORT=3000

# ------------------- Datenhaltung -------------------
# Verwende 1 für Datei-basiertes DB (für Entwicklung), 0 für echte DB
USE_FILE_DB=1
DB_HOST=127.0.0.1
DB_USER=krippe
DB_PASSWORD=
DB_DATABASE=krippe

# ----------------------- Pfade ----------------------
PUBLIC_DIR=/home/singer/led-sound-bachlauf/public
DB_DIR=/home/singer/led-sound-bachlauf/db
DATA_DIR=/home/singer/led-sound-bachlauf/data

# ----------------------- Audio ----------------------
AUDIO_DIR=/home/singer/led-sound-bachlauf/audio
AUDIO_SPEECH_DIR=/home/singer/led-sound-bachlauf/audio/krippe/Audiosprachdateien
AUDIO_BGM_DIR=/home/singer/led-sound-bachlauf/audio/krippe/Hintergrundmusik
AUDIO_OUTPUT_DEVICE=hw:1,0
AUDIO_DEBUG_ENABLED=0

# -------------------- LED-Konfiguration --------------------
# Für rpi-ws281x (BCM GPIO)
LED_GPIO=12
LED_BRIGHTNESS=128
LED_COUNT=1000
LED_ORDER=GRB

# -------------------- GPIO / Aktoren --------------------
# Pumpe (BCM-Nummer). Beispiel: 22
PUMP_GPIO=22
# Taster für Audio-Trigger (optional)
AUDIO_BUTTON_GPIO=17
# Setze auf 1 wenn das Relais aktiv HIGH ist, 0 wenn aktiv LOW (hier: active LOW)
PUMP_ACTIVE_HIGH=0

# ------------- GPIO initialisation / pigpio -------------
# Anzahl Versuche, pigpio zu initialisieren bevor aufgegeben wird
GPIO_INIT_RETRIES=5
# Wartezeit zwischen Versuchen in Millisekunden
GPIO_INIT_RETRY_DELAY_MS=500

# Optional: Pfade und Warte-Settings für pigpiod socket/pid
#PIGPIO_SOCKET_PATH=/var/run/pigpio.sock
#PIGPIO_PID_PATH=/var/run/pigpio.pid
#PIGPIO_SOCKET_WAIT_ATTEMPTS=10
#PIGPIO_SOCKET_WAIT_DELAY_MS=200

# ---------------------- Scheduler ----------------------
CYCLE_TOTAL=300
CYCLE_DAY=100
CYCLE_DAYNIGHT=50
CYCLE_NIGHT=100
CYCLE_NIGHTDAY=50

# ----------------------- Logging -----------------------
MORGAN_ENABLED=1
MORGAN_FORMAT=combined
MORGAN_SKIP_HEALTH=1
MORGAN_TO_FILE=0
#MORGAN_FILE_PATH=/home/singer/led-sound-bachlauf/logs/access.log

# Ende der Datei
